{
  "name": "notes-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.vue\"",
    "format:check": "prettier --check \"app/**/*.vue\""
  },
  "dependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.1.4",
    "@pinia/nuxt": "^1.0.2",
    "eslint": "^9.0.0 || ^10.0.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
